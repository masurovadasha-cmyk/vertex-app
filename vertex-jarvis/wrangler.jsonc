{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "vertex-jarvis",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-29",
  "workers_dev": true,
  "preview_urls": true,
  "vars": {
    "OPENAI_MODEL_ASTRA": "gpt-6-astra",
    "OPENAI_MODEL_SOL": "gpt-6-sol",
    "OPENAI_MODEL_LUNA": "gpt-6-luna",
    "JARVIS_ENV": "development"
  },
  "triggers": {
    "crons": [
      "*/15 * * * *",
      "0 3 * * *"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "JARVIS_STATE",
        "class_name": "JarvisState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["JarvisState"]
    }
  ]
}
