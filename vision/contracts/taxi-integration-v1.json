{
  "version": 1,
  "module": "taxi",
  "name": "Vertex Taxi Integration API",
  "transport": {
    "browser": "external-app",
    "serverToServer": "cloudflare-service-binding-preferred",
    "publicHttpFallback": true
  },
  "authentication": {
    "type": "delegated-identity",
    "requiredHeaders": [
      "authorization",
      "x-vertex-user-id",
      "x-vertex-tenant-id",
      "x-vertex-organization-id",
      "x-vertex-correlation-id"
    ],
    "databaseCredentialsFromVision": false,
    "delegation": {
      "userIdSource": "verified-vision-identity",
      "tenantOrganizationContext": "server-authoritative-session-scope",
      "memberAuthorizationRequired": true,
      "clientSuppliedUserIdAccepted": false
    }
  },
  "endpoints": {
    "capabilities": {
      "method": "GET",
      "path": "/integration/v1/capabilities"
    },
    "ride": {
      "method": "GET",
      "path": "/integration/v1/rides/{ride_id}"
    },
    "createRide": {
      "method": "POST",
      "path": "/integration/v1/rides",
      "idempotencyRequired": true
    },
    "commandRide": {
      "method": "POST",
      "path": "/integration/v1/rides/{ride_id}/commands",
      "idempotencyRequired": true,
      "allowedCommands": [
        "cancel"
      ]
    },
    "health": {
      "method": "GET",
      "path": "/integration/v1/health"
    }
  },
  "responseRules": {
    "sourceOfTruth": "vertex-taxi-core",
    "visionMayPersistReferenceOnly": true,
    "visionMayNotPersistTaxiPrivateState": true
  },
  "failurePolicy": {
    "timeoutMs": 2500,
    "retries": 2,
    "retryOnlyIdempotentRequests": true,
    "failClosed": true
  },
  "visionGateway": {
    "status": "implemented-staging-capable",
    "routes": [
      "GET /api/taxi/capabilities",
      "GET /api/taxi/health",
      "GET /api/taxi/rides/{ride_id}",
      "POST /api/taxi/rides",
      "POST /api/taxi/rides/{ride_id}/commands"
    ],
    "serviceBinding": "optional VERTEX_TAXI_CORE",
    "httpFallback": "optional TAXI_INTEGRATION_URL + secret",
    "databaseAccess": "none",
    "mutationIdempotencyRequired": true
  }
}
