{
  "product": "VERTEX Vision",
  "assembly": "0.1",
  "architectureVersion": "1.6",
  "releaseManifest": "vision/release/0.1-RC1.json",
  "platformVersion": "1.16-rc1",
  "apiVersion": "v1",
  "database": {
    "latestMigration": "0011_event_inbox.sql",
    "migrationsExpected": 11,
    "sourceOfTruth": "PostgreSQL/Supabase",
    "productionApplied": false
  },
  "modules": {
    "active": [
      "views"
    ],
    "comingSoonCount": 18,
    "registryCount": 19
  },
  "views": {
    "ui": [
      "dashboard",
      "calendar",
      "bookings",
      "units",
      "cleaning"
    ],
    "backend": "/api/v1/views",
    "commands": [
      "create_booking",
      "confirm_booking",
      "check_in",
      "check_out",
      "cancel_booking",
      "cleaning_start",
      "cleaning_submit",
      "cleaning_verify"
    ],
    "authoritativeWrites": "database-rpc",
    "demoFallbackInOperations": false
  },
  "runtimes": {
    "web": {
      "source": "vision/platform",
      "buildOutput": "vertex/dist"
    },
    "android": {
      "packageId": "com.vertex.vision.demo",
      "versionName": "1.16-rc1",
      "versionCode": 20
    },
    "stagingWorker": {
      "name": "vertex-vision-staging",
      "config": "vision/wrangler.jsonc"
    },
    "productionWorker": {
      "name": "vertex-app",
      "config": "wrangler.jsonc",
      "approved": false
    }
  },
  "boundaries": {
    "jarvis": "separate-project-external-api-only",
    "productionMerge": false,
    "productionDeploy": false,
    "cloudDatabaseMigration": false
  },
  "gates": [
    "assembly-contract",
    "server-authoritative-session-context",
    "typed-command-contract",
    "typed-response-contract",
    "request-correlation-trace",
    "runtime-readiness",
    "event-inbox-idempotency",
    "unit-regression",
    "postgresql-rls",
    "views-vertical-flow",
    "browser-desktop-mobile",
    "android-build-signature-assets",
    "cloudflare-production-dry-run",
    "cloudflare-staging-dry-run",
    "real-supabase-auth-e2e",
    "expand-only-migration-policy",
    "read-only-release-preflight",
    "backup-restore-drill",
    "n-minus-one-schema-compatibility",
    "rollback-policy",
    "production-promotion-evidence",
    "production-backup-restore-evidence",
    "trusted-release-controller",
    "effective-read-only-backup-principal"
  ],
  "kernel": {
    "routePolicy": "vision/backend/kernel.mjs",
    "contextEndpoint": "/api/v1/context",
    "permissionSource": "postgresql-rbac-only",
    "clientPermissionClaimsTrusted": false,
    "organizationScopeRequired": true,
    "commandContract": "vision/modules/views/command-contract.mjs",
    "commandSchemaVersion": "v1",
    "commandValidationLayers": [
      "api-contract",
      "postgresql-domain"
    ],
    "responseContract": "vision/modules/views/response-contract.mjs",
    "responseProjection": "allowlisted-command-dto",
    "traceHeaders": [
      "X-Request-ID",
      "X-Correlation-ID"
    ]
  },
  "readiness": {
    "endpoint": "/readyz",
    "rpc": "public.vision_runtime_readiness()",
    "checks": [
      "migration-level",
      "required-tables",
      "required-rpcs",
      "rls",
      "views-release-active",
      "event-inbox"
    ],
    "serviceRoleRequired": false
  },
  "externalGates": {
    "realStagingAuthE2E": {
      "workflow": ".github/workflows/vision-cloud-e2e.yml",
      "mode": "manual-staging-environment",
      "required": true,
      "verified": false,
      "productionChanged": false
    }
  },
  "reliability": {
    "outbox": "transactional-at-least-once",
    "inbox": "durable-deduplication-with-lease",
    "globalExactlyOnce": false
  },
  "productionSafety": {
    "manifest": "vision/production/safety-manifest.json",
    "rollbackPlan": "vision/production/rollback-plan.json",
    "workflow": ".github/workflows/vision-rc2-safety.yml",
    "backupRestoreRequired": true,
    "readOnlyPreflightRequired": true,
    "productionApproved": false,
    "nMinusOneCompatibility": "vision/production/check-n-minus-one-compatibility.mjs",
    "ciBackupRestoreDrillRequired": true,
    "productionBackupRestoreVerified": false,
    "stagingDeployMode": "manual-only"
  },
  "productionPromotion": {
    "policy": "vision/production/promotion-policy.json",
    "evaluator": "vision/production/evaluate-promotion.mjs",
    "workflow": ".github/workflows/vision-promotion-gate.yml",
    "productionBackupWorkflow": ".github/workflows/vision-production-backup-restore.yml",
    "mutationAllowed": false,
    "passed": false,
    "trustedController": {
      "version": "0.1",
      "requiredRef": "refs/heads/master",
      "candidateCheckout": "separate-exact-sha",
      "evidenceWorkflowMetadataVerified": true,
      "firstPartyActionsPinnedByCommit": true,
      "productionMutationAllowed": false
    }
  }
}
