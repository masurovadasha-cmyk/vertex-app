{
  "openapi": "3.1.0",
  "info": {
    "title": "VERTEX Engineers API",
    "version": "0.2.0"
  },
  "servers": [
    {
      "url": "/api/v1/engineers"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "getEngineersHealth",
        "responses": {
          "200": {
            "description": "Module health"
          }
        }
      }
    },
    "/projects": {
      "get": {
        "operationId": "listEngineerProjects",
        "responses": {
          "200": {
            "description": "Projects"
          }
        }
      },
      "post": {
        "operationId": "createEngineerProject",
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Invalid input"
          }
        }
      }
    },
    "/projects/{projectId}/stage": {
      "post": {
        "operationId": "advanceEngineerProject",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Updated"
          },
          "400": {
            "description": "Invalid transition"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/assets": {
      "get": {
        "operationId": "listEngineerAssets",
        "responses": {
          "200": {
            "description": "Engineering assets"
          }
        }
      }
    },
    "/assets/elevators": {
      "post": {
        "operationId": "registerElevatorAsset",
        "responses": {
          "201": {
            "description": "Elevator asset registered"
          },
          "400": {
            "description": "Invalid input"
          }
        }
      }
    },
    "/assets/hvac": {
      "post": {
        "operationId": "registerHvacAsset",
        "responses": {
          "201": {
            "description": "HVAC/MEP asset registered"
          },
          "400": {
            "description": "Invalid input"
          }
        }
      }
    },
    "/assets/{assetId}/commission": {
      "post": {
        "operationId": "commissionEngineerAsset",
        "parameters": [
          {
            "name": "assetId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Asset commissioned"
          },
          "400": {
            "description": "Invalid lifecycle state"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/work-orders": {
      "get": {
        "operationId": "listEngineerWorkOrders",
        "responses": {
          "200": {
            "description": "Work orders"
          }
        }
      },
      "post": {
        "operationId": "createEngineerWorkOrder",
        "responses": {
          "201": {
            "description": "Work order created"
          },
          "400": {
            "description": "Invalid input"
          }
        }
      }
    },
    "/work-orders/{workOrderId}/transition": {
      "post": {
        "operationId": "transitionEngineerWorkOrder",
        "parameters": [
          {
            "name": "workOrderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Work order updated"
          },
          "400": {
            "description": "Invalid transition"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/product-references": {
      "get": {
        "operationId": "listProductReferences",
        "responses": {
          "200": {
            "description": "Reference-only engineering product catalog"
          }
        }
      }
    }
  },
  "x-vertex-boundary": {
    "scope_headers": [
      "x-tenant-id",
      "x-organization-id"
    ],
    "event_headers": [
      "x-event-id",
      "x-correlation-id"
    ],
    "integration": "standalone; future VERTEX Vision adapter only"
  }
}
