{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "vertex-vision-staging",
  "main": "backend/worker.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {"directory": "../vertex/dist", "binding": "ASSETS", "run_worker_first": ["/api/*", "/health", "/readyz", "/system-status", "/auth-config"]},
  "vars": {"VISION_ENV": "staging"},
  "observability": {"enabled": true, "head_sampling_rate": 1}
}
