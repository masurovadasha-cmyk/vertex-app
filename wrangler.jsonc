{
  "name": "vertex-app",
  "main": "vision/platform/worker.mjs",
  "compatibility_date": "2026-10-01",
  "keep_vars": true,
  "preview_urls": true,
  "previews": {},
  "build": {
    "command": "npm run build:vision"
  },
  "assets": {
    "directory": "./vertex/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/health", "/readyz", "/vision", "/vision/*"]
  }
}
