{
  "product": "VERTEX Vision",
  "release": "0.1-RC1",
  "platformVersion": "1.16-rc1",
  "api": "v1",
  "databaseMigration": "0009_application_kernel.sql",
  "activeModules": [
    "views"
  ],
  "comingSoonModules": [
    "managing",
    "real-estate",
    "engineers",
    "aura-design",
    "travel",
    "aviation",
    "rent-car",
    "taxi",
    "concierge",
    "cleaning",
    "laundry",
    "ditalia",
    "market",
    "bar",
    "technologies",
    "investment",
    "ventures",
    "training"
  ],
  "cloudStagingVerified": false,
  "productionApproved": false,
  "productionReady": false,
  "jarvisIntegration": "external-api-only",
  "notes": [
    "Views is the only launchable module from the VERTEX Vision Hub.",
    "All other divisions are registered future branches and expose no Hub launch actions.",
    "Production and master deployment require a separate approval after staging verification."
  ],
  "viewsOperations": {
    "status": "implemented-in-branch",
    "apiBase": "/api/v1/views",
    "commands": [
      "create_booking",
      "confirm_booking",
      "check_in",
      "check_out",
      "cancel_booking",
      "cleaning_start",
      "cleaning_submit",
      "cleaning_verify"
    ],
    "cloudStagingVerified": false
  },
  "viewsUI": {
    "status": "implemented-in-branch",
    "primaryAction": "operations",
    "tabs": [
      "dashboard",
      "calendar",
      "bookings",
      "units",
      "cleaning"
    ],
    "dataPolicy": "real-staging-only-no-demo-fallback",
    "sessionPolicy": "server-authoritative-context-from-verified-jwt",
    "cloudStagingVerified": false
  },
  "architectureVersion": "1.2",
  "technicalStage": "application-kernel-0.1",
  "viewsIntegrity": {
    "status": "implemented-in-branch",
    "inventory": "unique-tenant-unit-night",
    "quality": "independent-executor-reviewer",
    "moduleGate": "SQL-and-RLS",
    "cloudMigrationApplied": false
  },
  "viewsReadAPI": {
    "format": "array",
    "defaultLimit": 50,
    "maxLimit": 100,
    "cursorHeader": "X-Next-Cursor",
    "projection": "allowlisted-fields",
    "organizationScope": "required"
  },
  "integratedAssembly": {
    "status": "implemented-in-branch",
    "manifest": "vision/assembly/manifest.json",
    "verifier": "vision/tools/verify-assembly.mjs",
    "workflow": ".github/workflows/vision-assembly.yml",
    "productionApproved": false
  },
  "applicationKernel": {
    "status": "implemented-in-branch",
    "routePolicy": "vision/backend/kernel.mjs",
    "sessionContext": "public.vision_session_context(uuid,uuid)",
    "contextEndpoint": "/api/v1/context",
    "permissionSource": "postgresql-rbac-only",
    "clientPermissionClaimsTrusted": false,
    "organizationScopeRequired": true
  }
}
